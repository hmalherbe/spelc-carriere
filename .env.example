# Copie ce fichier en .env (jamais commité) sur le serveur, et remplis les valeurs réelles.
# docker-compose lit automatiquement .env à la racine du dépôt.

# Mot de passe PostgreSQL — génère-en un fort, ex: openssl rand -base64 24
POSTGRES_PASSWORD=

# Secret de signature des jetons JWT — génère-en un fort, ex: openssl rand -base64 48
JWT_SECRET=

# Compte admin créé automatiquement au démarrage (voir prisma/seed.ts) — laisse vide pour ne
# créer aucun compte admin (tu en crées un autrement, ou plus tard).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mailing (Brevo) — laisse vide pour désactiver l'envoi (l'écran Mailing reste utilisable, l'envoi
# renvoie juste une erreur explicite tant que ce n'est pas configuré).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Spelc

# Synchronisation ADEL — laisse vide pour désactiver (même comportement : erreur explicite plutôt
# qu'un échec silencieux). Voir README.md pour le détail du scraper. Optionnel désormais : ces
# identifiants peuvent aussi être saisis/modifiés depuis l'onglet Paramètres de l'application (par
# un compte ADMIN), sans redéploiement — ce qui prend le pas sur ces variables si les deux existent.
ADEL_URL=
ADEL_USERNAME=
ADEL_PASSWORD=
ADEL_SPELC_NAME=azur
