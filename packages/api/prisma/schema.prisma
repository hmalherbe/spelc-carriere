// Data model for the Spelc career-management system.
// Scope (per product decision): académie de Nice (06/83) only for V1, multi-user with roles,
// stable-ID adherent↔teacher matching with a manual review queue, and an auto-estimated but
// lockable/overridable "BA" (bonification d'ancienneté) selection threshold.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / users
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // full access: manage users, lock BA thresholds, edit reference data (grille, barèmes)
  GESTIONNAIRE // day-to-day use: imports, matching review, mailing
  LECTURE // read-only
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  role            Role             @default(GESTIONNAIRE)
  passwordHash    String
  createdAt       DateTime         @default(now())
  reviewedMatches MatchCandidate[] @relation("ReviewedBy")
  lockedSeuils    BaSeuil[]        @relation("LockedBy")
}

// ---------------------------------------------------------------------------
// Reference data (grille indiciaire, barèmes, reclassements) — seeded from the
// central .xlsm's "Données" sheet, editable by an ADMIN when the grille is revalorised.
// ---------------------------------------------------------------------------

model Grille {
  code  String       @id // "AGR", "PROFS", "HC_AGR", "EXC_PROFS", ... (matches GrilleCode in @spelc/domain)
  label String
  rows  EchelonRow[]
}

model EchelonRow {
  id               String @id @default(cuid())
  grille           Grille @relation(fields: [grilleCode], references: [code])
  grilleCode       String
  echelon          String // stored as text: numeric échelons and lettered ones ("A1".."A3","B2","B3") share this column
  echelonSuivant   String
  indice           Int
  dureeAnnees      Float? // null means "MAX" (ceiling échelon, no further promotion)
  dureeAlternative Float? // "avant vivier 2" (HC) or "au choix" (MA1/MA2) duration, when it differs from dureeAnnees

  @@unique([grilleCode, echelon])
}

model ValeurDuPoint {
  id          String   @id @default(cuid())
  valeur      Float
  applicableA DateTime // date this value takes effect, so historical calculations stay reproducible
}

model GradeMapping {
  grade                     String  @id // rectorat grade label, e.g. "CERTIFIE HC"
  grilleCode                String
  degre                     Int // 1 = premier degré, 2 = second degré
  accesHorsClasse           Boolean @default(false)
  accesClasseExceptionnelle Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Teachers, as they appear in each rectorat campaign export (source of truth for
// échelon/promotion state — this table is append-only per campaign, never mutated in place,
// so a re-import never silently loses history).
// ---------------------------------------------------------------------------

model Campagne {
  id            String   @id @default(cuid())
  anneeScolaire String // e.g. "2024-2025"
  periodeDebut  DateTime
  periodeFin    DateTime
  dateCcma      DateTime // reference date used for "date de régularisation financière" calculations
  createdAt     DateTime @default(now())

  imports          RectoratImport[]
  teacherSnapshots TeacherSnapshot[]
  baSeuils         BaSeuil[]
  mailingLogs      MailingLog[]
}

model RectoratImport {
  id         String            @id @default(cuid())
  campagne   Campagne          @relation(fields: [campagneId], references: [id])
  campagneId String
  grade      String // "4531 : ECR PROFESSEUR CERTIFIE CL. NORMALE" style rectorat grade code+label
  fileName   String
  importedAt DateTime          @default(now())
  importedBy String? // free-text/email, kept even if the User row is later deleted
  rowCount   Int
  snapshots  TeacherSnapshot[]
}

// One row = one teacher's state as it appeared in one rectorat PDF/campaign export.
// Mirrors the fields we identified in the rectorat "AVANCEMENT D'ECHELON" export format.
model TeacherSnapshot {
  id         String         @id @default(cuid())
  campagne   Campagne       @relation(fields: [campagneId], references: [id])
  campagneId String
  import     RectoratImport @relation(fields: [importId], references: [id])
  importId   String

  // Stable identity is NOT derived from name matching here — this snapshot always belongs to a
  // Teacher row (created/reused via the matching engine below) so history survives name changes,
  // typos, or re-imports.
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String

  nomUsage                       String
  prenom                         String
  // Normalized rectorat grade label (matches GradeMapping.grade in @spelc/domain, e.g. "CERTIFIE",
  // "AGREGE HC") — distinct from RectoratImport.grade, which is the raw file-level label
  // ("4531 : ECR PROFESSEUR CERTIFIE CL. NORMALE"). Drives the grille lookup and BA threshold matching.
  grade                          String
  dateNaissance                  DateTime?
  rneEtablissement               String?
  nomEtablissement               String?
  typeEtablissement              String? // CLG/LGT/LP/LPO/LT/LYT CC/ECS/SEP...
  codePostal                     String?
  ville                          String?
  disciplineCode                 String?
  disciplineLibelle              String?
  echelonActuel                  String
  dateAccesEchelon               DateTime
  avisEvaluation                 Int? // 0-4, only populated for grades/échelons with a rendez-vous de carrière
  // "Z1AGRA" / "Z1ANEC" in the raw rectorat export's barème block — ancienneté (in years) in the
  // current grade and in the current échelon, respectively. Feed directly into the BA threshold
  // cascade (see BaSeuil / computeBASeuils in @spelc/domain).
  ancienneteGrade                Float?
  ancienneteEchelon              Float?
  // "Z2AGEA" in the raw rectorat export's barème block — the teacher's age at the campaign's
  // reference date, packed as "AAMMJJ" (years/months/days), kept verbatim; see parseZ2AGEA in
  // @spelc/import to decode. Feeds the BA threshold's age tie-break (see baSeuilCompute.ts).
  ageEncodedRectorat              String?
  typePromotion                  String? // AN / CL / BA / RE, as printed in the rectorat export
  dureeRestante                  String? // "XXaYYmZZj" raw text, kept verbatim for audit/debugging
  dateProchainePromotionRectorat DateTime? // as stated BY the rectorat itself, kept separate from our own computed estimate
  // The "TRACK.date" marker (e.g. "BA.18/07/2025" or "Pro BA.18/07/2025") — distinct from
  // typePromotion/dureeRestante above. Drives baEligible in routes/teachers.ts ("BA" = candidate
  // for the bonification d'ancienneté this cycle, whether granted or not).
  // NOTE: the "Pro " prefix ("Promu") reliably marks a CONFIRMED promotion for AN/CL/RE (automatic
  // mechanisms — verified against many real records), but NOT for BA specifically: on a real file,
  // the two candidates actually granted BA carried no "Pro" prefix at all, only their barème
  // ranking set them apart from the rest of the section. So proConfirmee is trustworthy for
  // AN/CL/RE, but BA confirmation is instead derived by ranking every BA candidate in a section
  // against nombrePromusBaSection below (see rankBACandidates in @spelc/domain, used from
  // routes/teachers.ts) — not from this flag.
  proTypePromotion               String? // AN / CL / BA
  proConfirmee                   Boolean @default(false)
  // The échelon section's own "NOMBRE DE PROMUS" (BA column) from the rectorat file — the exact
  // count of how many BA candidates in this (grade, échelon actuel) group were actually granted
  // the bonification this cycle. Same value repeated across every record in the section
  // (denormalized for simplicity); null when the footer wasn't found/parseable.
  nombrePromusBaSection           Int?
  // 0-based position this record held within its own rectorat file (gradeBlock.records order in
  // routes/imports.ts) — lets the teacher list be sorted the same way the rectorat's own export
  // presents them, instead of only alphabetically. Meaningful only within one grade's own snapshots
  // (each grade comes from its own separate file/RectoratImport) — see routes/teachers.ts and
  // DashboardPage.tsx's "fichier" sort, which groups by grade first, then by this field. Existing
  // rows imported before this field existed default to 0 and need a re-import to get a real order.
  rowIndex                        Int      @default(0)

  @@index([campagneId, teacherId])
}

// The stable entity a human is actually tracking across campaigns and re-imports.
model Teacher {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  snapshots      TeacherSnapshot[]
  matchCandidate MatchCandidate?
  computedStates ComputedPromotionState[]
  mailingLogs    MailingLog[]
}

// ---------------------------------------------------------------------------
// Adhérents (from the union's own membership export, "ADEL")
// ---------------------------------------------------------------------------

model Adherent {
  id             String    @id @default(cuid())
  civilite       String?
  nom            String
  prenom         String
  nomNaissance   String?
  grade          String?
  echelleSpelc   String?
  ancienEchelon  String?
  statut         String?
  typeContrat    String?
  ancienIndice   Int?
  dateEffet      DateTime?
  mailPersonnel  String?
  mailAcademique String?
  departement    String?
  importedAt     DateTime  @default(now())

  matchCandidate MatchCandidate?
}

// Académie staff-directory export (nom/prénom -> adresse mail académique), imported separately
// from the Spelc adhérent roster. Used only to email teachers who are NOT (yet) adhérents — an
// adhérent is always mailed at their personal address; a non-adhérent has no personal address on
// file, so this is the only way to reach them. Looked up by normalized nom+prénom at send time,
// never linked 1:1 to a Teacher/Adherent row (this data covers far more people than the union
// tracks, and changes independently on its own import cadence).
model AcademicEmail {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  email      String
  importedAt DateTime @default(now())

  @@index([nom, prenom])
}

// ---------------------------------------------------------------------------
// Matching: per product decision, the first resolution of an adherent↔teacher link is
// reviewed by a human and then PERMANENT (a stable Teacher/Adherent pairing) — later imports
// only need to resolve genuinely NEW or ambiguous cases, never re-litigate confirmed links.
// ---------------------------------------------------------------------------

enum MatchStatus {
  AUTO_CONFIRMED // exact/unambiguous fuzzy match, no review needed
  PENDING_REVIEW // ambiguous or below-confidence match, sitting in the review queue
  CONFIRMED // a human reviewed and confirmed the link
  REJECTED // a human reviewed and declared this NOT a match (adherent has no linked teacher yet)
}

model MatchCandidate {
  id           String      @id @default(cuid())
  teacher      Teacher?    @relation(fields: [teacherId], references: [id])
  teacherId    String?     @unique
  adherent     Adherent    @relation(fields: [adherentId], references: [id])
  adherentId   String      @unique
  status       MatchStatus @default(PENDING_REVIEW)
  confidence   Float // 0-1, from the fuzzy-matching step (normalized nom/prénom distance)
  reviewedBy   User?       @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Computed promotion state — the OUTPUT of the @spelc/domain calculation engine for one
// Teacher in one Campagne. Recomputed whenever a new snapshot or a BA seuil changes; never
// hand-edited, so it can always be safely thrown away and regenerated.
// ---------------------------------------------------------------------------

model ComputedPromotionState {
  id         String   @id @default(cuid())
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  teacherId  String
  campagneId String
  computedAt DateTime @default(now())

  grilleCode             String
  echelonDepart          String
  echelonSuivant         String
  indiceActuel           Int
  futurIndice            Int
  gainSalaireBrut        Int
  gainSalaireNet         Int
  dateProchainePromotion DateTime?
  baEstimate             String? // "promu_estime" | "non_promu_estime" | "indetermine", null if not échelon 6/8

  @@unique([teacherId, campagneId])
}

// ---------------------------------------------------------------------------
// "BA" (bonification d'ancienneté) selection threshold — auto-inferred each campaign from
// confirmed results at échelon 6/8, but an ADMIN can lock/override it (per product decision)
// once the rectorat's official cutoff is known, so the estimate stops drifting.
// ---------------------------------------------------------------------------

model BaSeuil {
  id                   String   @id @default(cuid())
  campagne             Campagne @relation(fields: [campagneId], references: [id])
  campagneId           String
  grade                String
  echelonDepart        Int // 6 or 8
  nombrePromusBa       Int
  minBareme            Int
  minAncienneteGrade   Float
  minAncienneteEchelon Float
  minAge               Int
  locked               Boolean  @default(false)
  lockedBy             User?    @relation("LockedBy", fields: [lockedById], references: [id])
  lockedById           String?
  updatedAt            DateTime @updatedAt

  @@unique([campagneId, grade, echelonDepart])
}

// ---------------------------------------------------------------------------
// Mailing — notifies teachers of their échelon promotion (gain, date) via Brevo: adhérents at
// their personal address, non-adhérents at their academic address (see AcademicEmail). One row
// per send attempt, so a teacher is never notified twice for the same campagne by accident and
// the send screen can show what's already gone out.
// ---------------------------------------------------------------------------

enum MailingStatus {
  SENT
  FAILED
}

model MailingLog {
  id             String        @id @default(cuid())
  campagne       Campagne      @relation(fields: [campagneId], references: [id])
  campagneId     String
  teacher        Teacher       @relation(fields: [teacherId], references: [id])
  teacherId      String
  adherentId     String? // null for a non-adhérent notified at their academic address
  email          String
  status         MailingStatus
  error          String? // Brevo error message, when status = FAILED
  brevoMessageId String?
  sentById       String // free-text: User.id at send time, kept even if the user is later deleted
  sentAt         DateTime      @default(now())

  @@unique([campagneId, teacherId])
  @@index([campagneId])
}

// ---------------------------------------------------------------------------
// ADEL sync — one row per attempt to pull the adhérents export automatically from ADEL (the
// union's own membership database) via the Playwright scraper in packages/scraper, instead of a
// human exporting + uploading the file by hand. Kept even on failure so the UI can show "dernière
// mise à jour" (or the last error) without a separate polling mechanism.
// ---------------------------------------------------------------------------

enum AdelSyncType {
  CCMA
  CCMI
}

enum AdelSyncStatus {
  SUCCESS
  FAILED
}

model AdelSyncLog {
  id            String         @id @default(cuid())
  type          AdelSyncType
  status        AdelSyncStatus
  syncedAt      DateTime       @default(now())
  created       Int            @default(0)
  updated       Int            @default(0)
  error         String?
  triggeredById String // free-text: User.id at sync time, kept even if the user is later deleted

  @@index([type, syncedAt])
}

// ---------------------------------------------------------------------------
// App settings — admin-editable via the "Paramètres" screen, so a credential change (e.g. the
// ADEL password rotating, or the Brevo API key) doesn't require touching the server's .env and
// redeploying. One singleton row per integration (id fixed to "singleton") rather than a generic
// key/value table: a real table keeps each field's shape — and any secret's encryption — explicit
// instead of stringly-typed.
// ---------------------------------------------------------------------------

model AdelConfig {
  id                String   @id @default("singleton")
  loginUrl          String?
  username          String?
  passwordEncrypted String? // AES-256-GCM via ../src/crypto.ts — never stored in plaintext, never returned to the client
  spelcName         String   @default("azur")
  updatedAt         DateTime @updatedAt
  updatedById       String? // free-text: User.id at time of edit, kept even if the user is later deleted
}

model BrevoConfig {
  id              String   @id @default("singleton")
  apiKeyEncrypted String? // AES-256-GCM via ../src/crypto.ts — never stored in plaintext, never returned to the client
  senderEmail     String?
  senderName      String   @default("Spelc")
  // Test mode: while true, every /mailing/send redirects every recipient's e-mail to testEmail
  // instead of their real address (adhérent or académique), capped to testMaxSends recipients —
  // a safe way to try a real campaign end-to-end without reaching real teachers. Sends made this
  // way are never written to MailingLog, so they can't be mistaken later for the real campaign
  // having already gone out (see routes/mailing.ts).
  testMode        Boolean  @default(false)
  testEmail       String?
  testMaxSends    Int?
  updatedAt       DateTime @updatedAt
  updatedById     String? // free-text: User.id at time of edit, kept even if the user is later deleted
}
