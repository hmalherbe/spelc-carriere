# Caddy automates HTTPS: on first request for spelcca.fr/www.spelcca.fr it obtains a Let's
# Encrypt certificate via the HTTP-01 challenge (needs port 80 reachable from the internet, which
# docker-compose.yml already exposes), serves HTTPS on 443, and renews automatically well before
# expiry — no manual certbot/cron step needed. Plain HTTP requests are redirected to HTTPS
# automatically; that's Caddy's default for a site block with no explicit "http://" scheme.
{
	email {$CADDY_ACME_EMAIL}
}

spelcca.fr, www.spelcca.fr {
	reverse_proxy web:80
}
