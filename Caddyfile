# Caddy automates HTTPS: on first request for spelcca.fr/www.spelcca.fr it obtains a Let's
# Encrypt certificate via the HTTP-01 challenge (needs port 80 reachable from the internet, which
# docker-compose.yml already exposes), serves HTTPS on 443, and renews automatically well before
# expiry — no manual certbot/cron step needed. Plain HTTP requests are redirected to HTTPS
# automatically; that's Caddy's default for a site block with no explicit "http://" scheme. No
# global `email` option: it's only used for Let's Encrypt renewal-problem notices, not required
# for ACME to work at all, and a Caddyfile `{$VAR}` substitution against an unset/empty env var
# leaves the `email` directive with no argument, which Caddy refuses to start on.
spelcca.fr, www.spelcca.fr {
	reverse_proxy web:80
}

# Stack de test (docker-compose.test.yml, /opt/spelc-carriere-test), un déploiement Compose séparé
# avec son propre réseau Docker — caddy ne peut pas le joindre par nom de service comme web:80
# ci-dessus. Il expose déjà son port 8080 sur l'hôte, donc host.docker.internal:8080 (voir
# extra_hosts dans docker-compose.yml) suffit à l'atteindre depuis ce conteneur.
demo.spelcca.fr {
	reverse_proxy host.docker.internal:8080
}
